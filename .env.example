# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values
# Get these from Firebase Console > Project Settings > General > Your apps

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud receipt OCR (optional; server-side only, no NEXT_PUBLIC_ prefix)
# OCR_PROVIDER: "textract" to read receipts with Amazon Textract, or "none" (the default) to use
# Tesseract.js in the browser. On AWS Lambda the credentials are the execution role's, so there is
# no access key. Locally the AWS SDK would use whatever credentials your shell has: leave
# OCR_PROVIDER unset unless you mean to call Textract with them.
OCR_PROVIDER=
# TEXTRACT_REGION: optional, defaults to us-east-1.
TEXTRACT_REGION=
